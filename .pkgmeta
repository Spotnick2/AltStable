package-as: AltStable

# No nolib zip: a "no libraries" build would strip the vendored libraries AND
# LibGlass, and nothing would load it in their place.
enable-nolib-creation: no

# LibStub, LibDeflate and ChatThrottleLib are vendored in Libs/ (a library tag
# that moved under a release would be one more variable in a port whose whole
# problem is "which build is this true for").
#
# LibGlass-1.0, the glass material shared by the Glass addons (#184),
# LibShowcase-1.0, the camera showcase extracted from SheetUI.lua, and
# LibAccountSync-1.0, the own-account sync extracted from Core.lua (#198), are the
# externals: each pinned to a TAG, bumped only in a release made anyway.
# Comments on their own lines only - the packager's YAML reader keeps an inline
# "# ..." as part of the value (measured in GlassUnitFrames' migration).
externals:
  Libs/LibGlass-1.0:
    url: https://github.com/Spotnick2/LibGlass
    tag: r5
  Libs/LibShowcase-1.0:
    url: https://github.com/Spotnick2/LibShowcase
    tag: r3
  Libs/LibAccountSync-1.0:
    url: https://github.com/Spotnick2/LibAccountSync
    tag: r5

# One CurseForge project, four addon folders. WoW only discovers addons as
# top-level folders under Interface/AddOns, so the plugins cannot ship nested
# inside AltStable/ - the packager moves them out.
#
# Paths are relative to the packaged root, which is the `package-as` folder;
# each destination becomes its own sibling folder in the zip.
#
# The two packagers differ on the leftover: the BigWigs one (what CI dry-runs)
# deletes the emptied AltStable/Plugins directory, while CurseForge's - which
# builds the actual releases - leaves an empty `AltStable/Plugins/` entry in the
# zip. Measured on the published v0.1.0-beta. Harmless (the client ignores an
# empty directory), but it means CI cannot see it: the check asserts the BigWigs
# shape, not the shipped one.
move-folders:
  AltStable/Plugins/Warband: AltStableWarband
  AltStable/Plugins/Instances: AltStableInstances
  AltStable/Plugins/Roster: AltStableRoster
  AltStable/Plugins/Professions: AltStableProfessions

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# YAML list, not markdown bullets: a `*` here silently ignores nothing, which is
# how development files end up in a published zip.
#
# CHANGELOG.md appears here AND in manual-changelog on purpose: the packager
# reads it for the changelog, and this keeps the file itself out of the addon.
# LICENSE deliberately stays in the package - MIT requires the notice to travel
# with the distribution.
ignore:
  - .github
  - .claude
  - docs
  - tests
  - Tools
  - AGENTS.md
  - CLAUDE.md
  - README.md
  - CHANGELOG.md
  - Media/Raids/README.md
  # Scene documentation. The .tga files beside these DO ship - they are what the
  # client loads - but how the art was made is repository business, not a
  # download. The PNG masters and the reference screenshots are gitignored
  # entirely and never reach the packager at all.
  - Media/Scene/README.md
  - Media/Scene/PROMPTS.md
  # The library's own development files. Ignores match from the package root,
  # so the top-level docs/tests/Tools entries never reach inside Libs/, and
  # CurseForge's packager does not honour an external's own ignore list.
  # Libs/LibGlass-1.0/LICENSE ships (MIT).
  - Libs/LibGlass-1.0/tests
  - Libs/LibGlass-1.0/docs
  - Libs/LibGlass-1.0/Tools
  - Libs/LibGlass-1.0/AGENTS.md
  - Libs/LibGlass-1.0/CLAUDE.md
  - Libs/LibGlass-1.0/README.md
  # The same for LibShowcase-1.0 (its LICENSE ships too).
  - Libs/LibShowcase-1.0/tests
  - Libs/LibShowcase-1.0/docs
  - Libs/LibShowcase-1.0/Tools
  - Libs/LibShowcase-1.0/AGENTS.md
  - Libs/LibShowcase-1.0/CLAUDE.md
  - Libs/LibShowcase-1.0/README.md
  # The same for LibAccountSync-1.0 (its LICENSE ships, and so do its
  # ChatThrottleLib/ and LibStub/: its XML loads them).
  - Libs/LibAccountSync-1.0/tests
  - Libs/LibAccountSync-1.0/docs
  - Libs/LibAccountSync-1.0/Tools
  - Libs/LibAccountSync-1.0/AGENTS.md
  - Libs/LibAccountSync-1.0/CLAUDE.md
  - Libs/LibAccountSync-1.0/README.md
